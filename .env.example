PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Neon/PostgreSQL. Leave empty to use the local JSON fallback in data/indicacoes.json.
# Example: postgresql://usuario:senha@host.neon.tech/database?sslmode=require
DATABASE_URL=
DATABASE_INDICACOES_TABLE=indicacoes
PG_POOL_MAX=5

# Set PGSSL=false only when using a local PostgreSQL without SSL.
PGSSL=true

# Required for admin endpoints in production.
ADMIN_TOKEN=troque-esse-token

# Comma-separated list. Use * only while developing.
CORS_ORIGIN=http://localhost:3000
