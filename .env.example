PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Supabase/PostgreSQL. Leave empty to use the local JSON fallback in data/indicacoes.json.
# Use the PostgreSQL URI shown in Supabase's Connect panel.
DATABASE_URL=
DATABASE_INDICACOES_TABLE=indicacoes
PG_POOL_MAX=5

# API do Supabase. A SERVICE_ROLE_KEY é necessária para as rotas administrativas.
# Use SUPABASE_URL na Vercel para que ela permaneça como variável privada.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set PGSSL=false only when using a local PostgreSQL without SSL.
PGSSL=true

# Required for admin endpoints in production.
ADMIN_TOKEN=troque-esse-token

# Comma-separated list. Use * only while developing.
CORS_ORIGIN=http://localhost:3000
